{
  "$defs": {
    "Expectation": {
      "properties": {
        "kind": {
          "default": "unknown",
          "enum": [
            "navigate",
            "message",
            "status",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "default": "",
          "title": "Value",
          "type": "string"
        },
        "negate": {
          "default": false,
          "title": "Negate",
          "type": "boolean"
        },
        "status_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Code"
        },
        "body_contains": {
          "default": "",
          "title": "Body Contains",
          "type": "string"
        },
        "validate_schema": {
          "default": false,
          "title": "Validate Schema",
          "type": "boolean"
        }
      },
      "title": "Expectation",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "artifact_id": {
          "default": "",
          "title": "Artifact Id",
          "type": "string"
        },
        "source": {
          "default": "rule",
          "enum": [
            "rule",
            "ai"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "TestScenario": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "type": {
          "enum": [
            "positive",
            "negative",
            "boundary"
          ],
          "title": "Type",
          "type": "string"
        },
        "channel": {
          "enum": [
            "ui",
            "api"
          ],
          "title": "Channel",
          "type": "string"
        },
        "ac_ids": {
          "items": {
            "type": "string"
          },
          "title": "Ac Ids",
          "type": "array"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "object"
        },
        "expected": {
          "$ref": "#/$defs/Expectation"
        },
        "priority": {
          "default": "P2",
          "enum": [
            "P1",
            "P2",
            "P3"
          ],
          "title": "Priority",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "spec_id": {
          "title": "Spec Id",
          "type": "string"
        },
        "spec_version": {
          "title": "Spec Version",
          "type": "string"
        },
        "ac_hash": {
          "title": "Ac Hash",
          "type": "string"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "obsolete"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "key",
        "title",
        "type",
        "channel",
        "ac_ids",
        "expected",
        "spec_id",
        "spec_version",
        "ac_hash"
      ],
      "title": "TestScenario",
      "type": "object"
    }
  },
  "properties": {
    "spec_id": {
      "title": "Spec Id",
      "type": "string"
    },
    "spec_version": {
      "title": "Spec Version",
      "type": "string"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/TestScenario"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "coverage_notes": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Coverage Notes",
      "type": "array"
    },
    "generated_by": {
      "default": "",
      "title": "Generated By",
      "type": "string"
    }
  },
  "required": [
    "spec_id",
    "spec_version"
  ],
  "title": "TestScenarioSet",
  "type": "object"
}