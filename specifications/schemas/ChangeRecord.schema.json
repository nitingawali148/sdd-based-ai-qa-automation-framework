            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old"
        },
        "new": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New"
        },
        "fields_changed": {
