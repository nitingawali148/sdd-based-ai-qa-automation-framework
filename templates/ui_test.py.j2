# >>> sdd:begin {{ t.automation_id }}
@pytest.mark.spec({{ spec.id|pyrepr }}, {{ tc.spec_version|pyrepr }})
@pytest.mark.ac({% for a in tc.ac_ids %}{{ a|pyrepr }}{% if not loop.last %}, {% endif %}{% endfor %})
@pytest.mark.tc({{ tc.id|pyrepr }})
@pytest.mark.automation_id({{ t.automation_id|pyrepr }})
@pytest.mark.priority({{ tc.priority|pyrepr }})
@pytest.mark.ui
{% for tag in tc.tags %}
@pytest.mark.{{ tag }}
{% endfor %}
def {{ t.function_name }}(page: Page, base_url: str) -> None:
    """{{ tc.id }}: {{ tc.title|replace('\\', '/') }}

    Acceptance criteria: {{ tc.ac_ids|join(', ') }} ({{ spec.id }} v{{ tc.spec_version }}, ac_hash {{ tc.ac_hash }})
    Expected: {{ tc.expected_result|replace('\\', '/') }}
    """
    {{ var }} = {{ page.class_name }}(page, base_url).open()
{% if fill %}
    {{ var }}.fill_form(
{% for f, cls in fill.items() %}
        {{ f }}=DATA.value({{ f|pyrepr }}, {{ cls|pyrepr }}),
{% endfor %}
    )
{% endif %}
    {{ var }}.submit()
{% if t.assertion.kind == "navigate" %}
    {{ target.class_name }}(page, base_url).expect_loaded()
{% elif t.assertion.negate %}
    {{ var }}.expect_no_message({{ t.assertion.value|pyrepr }})
{% else %}
    {{ var }}.expect_message({{ t.assertion.value|pyrepr }})
{% endif %}
# <<< sdd:end {{ t.automation_id }}
