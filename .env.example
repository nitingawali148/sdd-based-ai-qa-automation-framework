# ---------------------------------------------------------------------------
# LLM provider: offline | ollama | openai
#   offline  -> deterministic rule engine plugged into CrewAI as a BaseLLM.
#               No network, reproducible, every artifact is labelled "offline-rule-engine".
#   ollama   -> local Ollama server (recommended for private data)
#   openai   -> OpenAI API (needs OPENAI_API_KEY)
#   groq     -> Groq API, OpenAI-compatible (needs GROQ_API_KEY)
# ---------------------------------------------------------------------------
LLM_PROVIDER=offline
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.1
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Target environment (see config/framework.yaml -> environments)
# Production is blocked unless --allow-production is passed explicitly.
# ---------------------------------------------------------------------------
SDD_ENV=local

# Demo application under test (local FastAPI app, started automatically by pytest)
SDD_DEMO_PORT=8765
SDD_DEMO_USER_EMAIL=qa.user@demo.local
SDD_DEMO_USER_PASSWORD=Demo@12345
SDD_DEMO_ADMIN_EMAIL=admin@demo.local
SDD_DEMO_ADMIN_PASSWORD=Admin@12345
# Message the demo app returns for invalid credentials (used to demo spec drift)
SDD_DEMO_LOGIN_ERROR=Invalid email or password

# Keep CrewAI fully local
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_TRACING_ENABLED=false
